{
  "name": "seekstorm_client_ts",
  "version": "0.1.1",
  "description": "TypeScript Client for SeekStorm vector & lexical search server",
  "author": "Wolf Garbe <wolf.garbe@seekstorm.com>",
  "license": "Apache-2.0",
  "homepage": "https://seekstorm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeekStorm/seekstorm_client_ts.git"
  },
  "keywords": ["search", "information", "retrieval"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/seekstorm-client.test.js",
    "test:integration": "npm run build && node --test dist/integration/seekstorm-client.integration.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}