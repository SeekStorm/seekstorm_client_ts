{
  "name": "seekstorm-client",
  "version": "0.1.0",
  "description": "TypeScript REST client for the SeekStorm vector and lexical search server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/seekstorm-client.test.js",
    "test:integration": "npm run build && node --test dist/integration/seekstorm-client.integration.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}